{
  "openapi": "3.1.0",
  "info": {
    "title": "Toleman Public API",
    "version": "v1",
    "description": "Read/write access to targets, findings and scans, authenticated with a personal access token. Generated from the running application, not hand-written."
  },
  "servers": [
    {
      "url": "https://your-toleman-host",
      "description": "Your Toleman deployment"
    }
  ],
  "paths": {
    "/api/public/v1/targets": {
      "get": {
        "tags": [
          "public-api"
        ],
        "summary": "List Targets",
        "operationId": "list_targets_api_public_v1_targets_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": [
          {
            "ApiToken": []
          }
        ]
      }
    },
    "/api/public/v1/targets/{target_id}": {
      "get": {
        "tags": [
          "public-api"
        ],
        "summary": "Get Target",
        "operationId": "get_target_api_public_v1_targets__target_id__get",
        "security": [
          {
            "ApiToken": []
          }
        ],
        "parameters": [
          {
            "name": "target_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Target Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/public/v1/findings": {
      "get": {
        "tags": [
          "public-api"
        ],
        "summary": "List Findings",
        "operationId": "list_findings_api_public_v1_findings_get",
        "security": [
          {
            "ApiToken": []
          }
        ],
        "parameters": [
          {
            "name": "target_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Target Id"
            }
          },
          {
            "name": "severity",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Severity"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "State"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 25,
              "title": "Page Size"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/public/v1/findings/{finding_id}": {
      "get": {
        "tags": [
          "public-api"
        ],
        "summary": "Get Finding",
        "operationId": "get_finding_api_public_v1_findings__finding_id__get",
        "security": [
          {
            "ApiToken": []
          }
        ],
        "parameters": [
          {
            "name": "finding_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Finding Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/public/v1/scans/{scan_id}": {
      "get": {
        "tags": [
          "public-api"
        ],
        "summary": "Get Scan",
        "operationId": "get_scan_api_public_v1_scans__scan_id__get",
        "security": [
          {
            "ApiToken": []
          }
        ],
        "parameters": [
          {
            "name": "scan_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Scan Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/public/v1/scans": {
      "post": {
        "tags": [
          "public-api"
        ],
        "summary": "Trigger Scan",
        "description": "Requires a read_write-scoped token (see require_api_token_write_scope)\n-- the default token scope is read-only, so a caller must have\ndeliberately requested write access at token-creation time.",
        "operationId": "trigger_scan_api_public_v1_scans_post",
        "security": [
          {
            "ApiToken": []
          }
        ],
        "parameters": [
          {
            "name": "target_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Target Id"
            }
          },
          {
            "name": "tool",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Tool"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiToken": {
        "type": "http",
        "description": "Personal access token from Settings -> Workspace. Send as `Authorization: Bearer toleman_pat_...`.",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "security": [
    {
      "ApiToken": []
    }
  ]
}
